{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25 },

    "configurePresets": [
        {
            "name": "_base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "generator": "Ninja",
            "description": "On Windows, run scripts/Enter-DevShell.ps1 first so Ninja finds cl.exe. The architecture/toolset hints (strategy external) are ignored by CMake itself but tell Visual Studio and other IDEs to set up the MSVC environment.",
            "architecture": { "value": "x64", "strategy": "external" },
            "toolset": { "value": "host=x64", "strategy": "external" },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "JSPDLOG_WARNINGS_AS_ERRORS": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release (Ninja)",
            "description": "Optimized build, assertions stripped.",
            "inherits": "_base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "debug",
            "displayName": "Debug (Ninja)",
            "description": "Debug build with symbols and assertions.",
            "inherits": "_base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo (Ninja)",
            "description": "Optimized build with debug info, for profiling.",
            "inherits": "_base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "bench",
            "displayName": "Benchmark (Ninja)",
            "description": "Release build of the benchmark program only, without tests or examples.",
            "inherits": "_base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "JSPDLOG_BUILD_BENCH": "ON",
                "JSPDLOG_BUILD_TESTS": "OFF",
                "JSPDLOG_BUILD_EXAMPLES": "OFF",
                "JSPDLOG_INSTALL": "OFF"
            }
        },
        {
            "name": "_clang_ci_base",
            "hidden": true,
            "inherits": "_base",
            "description": "Shared base for the Clang sanitizer and coverage presets. Pins clang-23 and RelWithDebInfo. Linux only (locally, under WSL, or in CI).",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_C_COMPILER": "clang-23",
                "CMAKE_CXX_COMPILER": "clang++-23"
            }
        },
        {
            "name": "clang-asan-ubsan",
            "displayName": "Clang AddressSanitizer + UndefinedBehaviorSanitizer",
            "description": "The first finding fails the test binary (-fno-sanitize-recover=all).",
            "inherits": "_clang_ci_base",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "clang-tsan",
            "displayName": "Clang ThreadSanitizer",
            "description": "Covers the multi-threaded and async logging tests.",
            "inherits": "_clang_ci_base",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
            }
        },
        {
            "name": "clang-fuzz",
            "displayName": "Clang libFuzzer + AddressSanitizer + UndefinedBehaviorSanitizer",
            "description": "Builds the libFuzzer targets under build/clang-fuzz/test/fuzz. The test preset replays the saved inputs only.",
            "inherits": "_clang_ci_base",
            "cacheVariables": {
                "JSPDLOG_BUILD_FUZZERS": "ON",
                "JSPDLOG_BUILD_EXAMPLES": "OFF",
                "CMAKE_CXX_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "clang-coverage",
            "displayName": "Clang source-based coverage",
            "description": "Each test binary writes a .profraw under build/clang-coverage/profiles; scripts/ci/export-coverage.sh merges them into coverage.lcov.",
            "inherits": "_clang_ci_base",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
                "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate -fcoverage-mapping"
            }
        }
    ],

    "buildPresets": [
        { "name": "release", "configurePreset": "release" },
        { "name": "debug", "configurePreset": "debug" },
        { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
        { "name": "bench", "configurePreset": "bench", "targets": ["jspdlog_bench"] },
        { "name": "clang-asan-ubsan", "configurePreset": "clang-asan-ubsan" },
        { "name": "clang-tsan", "configurePreset": "clang-tsan" },
        { "name": "clang-fuzz", "configurePreset": "clang-fuzz" },
        { "name": "clang-coverage", "configurePreset": "clang-coverage" }
    ],

    "testPresets": [
        {
            "name": "_test_base",
            "hidden": true,
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        },
        { "name": "release", "configurePreset": "release", "inherits": "_test_base" },
        { "name": "debug", "configurePreset": "debug", "inherits": "_test_base" },
        { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo", "inherits": "_test_base" },
        {
            "name": "clang-asan-ubsan",
            "configurePreset": "clang-asan-ubsan",
            "inherits": "_test_base",
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1:abort_on_error=1:strict_string_checks=1:detect_stack_use_after_return=1",
                "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1:abort_on_error=1"
            }
        },
        {
            "name": "clang-tsan",
            "configurePreset": "clang-tsan",
            "inherits": "_test_base",
            "environment": { "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1" }
        },
        {
            "name": "clang-fuzz",
            "configurePreset": "clang-fuzz",
            "inherits": "_test_base",
            "filter": { "include": { "label": "fuzz-replay" } },
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1:abort_on_error=1:strict_string_checks=1:detect_stack_use_after_return=1",
                "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1:abort_on_error=1"
            }
        },
        {
            "name": "clang-coverage",
            "configurePreset": "clang-coverage",
            "inherits": "_test_base",
            "environment": { "LLVM_PROFILE_FILE": "${sourceDir}/build/clang-coverage/profiles/%p-%m.profraw" }
        }
    ],

    "workflowPresets": [
        {
            "name": "release",
            "steps": [
                { "type": "configure", "name": "release" },
                { "type": "build", "name": "release" },
                { "type": "test", "name": "release" }
            ]
        },
        {
            "name": "debug",
            "steps": [
                { "type": "configure", "name": "debug" },
                { "type": "build", "name": "debug" },
                { "type": "test", "name": "debug" }
            ]
        },
        {
            "name": "clang-asan-ubsan",
            "steps": [
                { "type": "configure", "name": "clang-asan-ubsan" },
                { "type": "build", "name": "clang-asan-ubsan" },
                { "type": "test", "name": "clang-asan-ubsan" }
            ]
        },
        {
            "name": "clang-tsan",
            "steps": [
                { "type": "configure", "name": "clang-tsan" },
                { "type": "build", "name": "clang-tsan" },
                { "type": "test", "name": "clang-tsan" }
            ]
        },
        {
            "name": "clang-fuzz",
            "steps": [
                { "type": "configure", "name": "clang-fuzz" },
                { "type": "build", "name": "clang-fuzz" },
                { "type": "test", "name": "clang-fuzz" }
            ]
        },
        {
            "name": "clang-coverage",
            "steps": [
                { "type": "configure", "name": "clang-coverage" },
                { "type": "build", "name": "clang-coverage" },
                { "type": "test", "name": "clang-coverage" }
            ]
        }
    ]
}
